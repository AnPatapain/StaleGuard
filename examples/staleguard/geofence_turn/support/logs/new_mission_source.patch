+"""Render reproducible plots from saved measurements; runs no simulations."""
+import argparse
+import json
+from pathlib import Path
+import numpy as np
+import matplotlib
+matplotlib.use('Agg')
+import matplotlib.pyplot as plt
+from .mission import BODY_RADIUS_M, HZ, Config
+
+
+def render(logs):
+    logs = Path(logs)
+    out = logs/'diagnostics'
+    out.mkdir(exist_ok=True)
+    s = json.loads((logs/'development_measured_bound/seed_6/scenario.json').read_text())
+    trace = np.load(logs/'development_measured_bound/seed_6/d0_trace.npz')['controls']
+    fig, ax = plt.subplots(1, 2, figsize=(11, 4), constrained_layout=True)
+    ax[0].plot(trace[:,1], trace[:,3], label='Actual PyBullet center')
+    ax[0].plot(trace[:,13], trace[:,15], '--', label='Frozen-command reference')
+    ax[0].axvline(s['fence_x'], color='black', label='Geofence plane')
+    ax[0].axvline(s['fence_x']-BODY_RADIUS_M-Config().d_min_m, color='tab:red', ls=':',
+                  label='Center limit: body radius + d_min')
+    target = s['command']['waypoint']
+    ax[0].plot(target[0], target[1], '*', ms=12, color='tab:green', label='Fixed waypoint')
+    ax[0].set(xlabel='X east (m)', ylabel='Y north (m)', title='Seed 6: D=0 actual horizontal turn')
+    ax[0].axis('equal')
+    ax[0].legend(fontsize=7)
+    for delay in (0., .2, .6, 1.):
+        path = logs/f'policy_smoke/seed6_D{delay}_no_recovery.npz'
+        if not path.exists():
+            continue
+        tr = np.load(path)['controls']
+        ax[1].plot(tr[:,0]/HZ-s['approval_s'], s['fence_x']-tr[:,1]-BODY_RADIUS_M,
+                   label=f'D={delay:.1f} s')
+    ax[1].axhline(Config().d_min_m, color='tab:red', ls=':', label='Required d_min=0.05 m')
+    ax[1].set(xlabel='Time since approval (s)', ylabel='Body clearance (m)',
+              title='No Recovery: 50 Hz view of saved actual states')
+    ax[1].legend(fontsize=8)
+    fig.savefig(out/'actual_turn_and_clearance.png', dpi=160)
+    plt.close(fig)
+    sweep = json.loads((logs/'characterization/envelope.json').read_text())['results']
+    fig, ax = plt.subplots(figsize=(9, 3.7), constrained_layout=True)
+    labels = [f"{r['speed']:.1f} / {r['radius']:.1f}" for r in sweep]
+    errors = [r['outcome']['max_tracking_error_m'] for r in sweep]
+    ax.bar(labels, errors, color=['tab:blue' if r['feasible'] else 'tab:red' for r in sweep])
+    ax.axhline(Config().tracking_limit_m, color='black', ls='--', label='Provisional 0.15 m tracking bound')
+    ax.set(xlabel='Speed (m/s) / radius (m)', ylabel='Maximum actual position tracking error (m)',
+           title='SCG/PID characterization: 9 preregistered pairs, altitude 1.25 m')
+    ax.legend(fontsize=8)
+    fig.savefig(out/'turning_envelope.png', dpi=160)
+    plt.close(fig)
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(__doc__)
+    parser.add_argument('--logs', default=str(Path(__file__).resolve().parent/'logs'))
+    render(parser.parse_args().logs)
