@@ -0,0 +1,169 @@
+"""Frozen command, deterministic references, and physical mission predicates."""
+from dataclasses import dataclass, asdict
+import math
+import numpy as np
+
+HZ = 50
+PHYSICS_HZ = 1000
+RAMP_S = .4  # Existing nominal acceleration ramp.
+# Enclosing sphere of SCG cf2x.urdf collision cylinder (r=.06, length=.025 m).
+BODY_RADIUS_M = math.hypot(.06, .025 / 2)
+POS = [0, 2, 4]
+VEL = [1, 3, 5]
+
+
+@dataclass(frozen=True)
+class Config:
+    # Provisional physical requirements, frozen before the characterization/run.
+    d_min_m: float = .05
+    position_tolerance_m: float = .10
+    velocity_tolerance_mps: float = .12
+    dwell_s: float = .20
+    # Provisional characterization acceptance bound, not a safety margin.
+    tracking_limit_m: float = .15
+    north_leg_s: float = .50
+    endpoint_s: float = 3.0
+    approval_min_s: float = .60
+    approval_max_s: float = 3.20
+    approval_grid_s: float = .20
+    max_rss_mb: int = 2048
+    min_available_mb: int = 2048
+
+
+@dataclass(frozen=True)
+class Command:
+    radius: float
+    speed: float
+    waypoint: tuple
+    north_leg_s: float
+    endpoint_s: float
+    direction: str = "TURN_LEFT_90"
+
+    def __post_init__(self):
+        if (self.radius <= 0 or self.speed <= 0 or self.north_leg_s < 0
+                or self.endpoint_s <= 0 or self.direction != "TURN_LEFT_90"
+                or len(self.waypoint) != 3
+                or not np.all(np.isfinite([self.radius, self.speed, self.north_leg_s,
+                                          self.endpoint_s, *self.waypoint]))):
+            raise ValueError("Invalid frozen turn command")
+        object.__setattr__(self, "waypoint", tuple(self.waypoint))
+
+    @property
+    def arc_s(self):
+        return math.pi * self.radius / (2 * self.speed)
+
+    @property
+    def duration_s(self):
+        return self.arc_s + self.north_leg_s + self.endpoint_s
+
+
+@dataclass(frozen=True)
+class Scenario:
+    seed: int
+    speed: float
+    height: float
+    initial_x: float
+    initial_y: float
+    fence_x: float
+    deadline_s: float  # relative to approval, identical for every policy
+    command: Command
+    approval_s: float = .60
+
+
+def scenario_dict(s):
+    return asdict(s)
+
+
+def scenario_from_dict(row):
+    row = dict(row)
+    row["command"] = Command(**row["command"])
+    return Scenario(**row)
+
+
+def make_forward_trajectory(n, s):
+    times = np.arange(n) / HZ
+    ramp = np.minimum(times, RAMP_S)
+    x = s.initial_x + s.speed * (ramp**2 / (2 * RAMP_S)
+                               + np.maximum(times - RAMP_S, 0))
+    ref = np.zeros((n, 12))
+    ref[:, 0] = x
+    ref[:, 1] = s.speed * np.minimum(times / RAMP_S, 1)
+    ref[:, 2] = s.initial_y
+    ref[:, 4] = s.height
+    return ref
+
+
+def endpoint_sample(t, p0, v0, target, duration):
+    """Quintic Hermite: p/v/a match start and terminal hold (zero end v/a)."""
+    u = np.clip(t / duration, 0, 1)
+    delta = np.asarray(target) - p0
+    # p=p0 + v0*T*u + a3*u^3+a4*u^4+a5*u^5; zero endpoint accelerations.
+    a3 = 10 * delta - 6 * duration * v0
+    a4 = -15 * delta + 8 * duration * v0
+    a5 = 6 * delta - 3 * duration * v0
+    pos = p0 + duration * v0 * u + a3*u**3 + a4*u**4 + a5*u**5
+    vel = v0 + (3*a3*u**2 + 4*a4*u**3 + 5*a5*u**4) / duration
+    return pos, vel
+
+
+def turn_sample(t, anchor, cmd):
+    """World-frame C1 path. Fixed durations; no route search or goal selection.
+
+    Dispatch anchor is the nominal reference row, NOT a newly optimized state.
+    The connector absorbs the different arc-end X at each dispatch and always
+    ends at cmd.waypoint. The command object is never mutated.
+    """
+    x0, y0, z0 = np.asarray(anchor)[POS]
+    if t <= cmd.arc_s:
+        theta = max(t, 0) * cmd.speed / cmd.radius
+        return (np.array([x0 + cmd.radius*np.sin(theta),
+                          y0 + cmd.radius*(1-np.cos(theta)), z0]),
+                np.array([cmd.speed*np.cos(theta), cmd.speed*np.sin(theta), 0]))
+    elapsed = t - cmd.arc_s
+    end = np.array([x0 + cmd.radius, y0 + cmd.radius, z0])
+    velocity = np.array([0., cmd.speed, 0.])
+    if elapsed <= cmd.north_leg_s:
+        return end + velocity * elapsed, velocity
+    end += velocity * cmd.north_leg_s
+    elapsed -= cmd.north_leg_s
+    if elapsed < cmd.endpoint_s:
+        return endpoint_sample(elapsed, end, velocity, cmd.waypoint, cmd.endpoint_s)
+    return np.asarray(cmd.waypoint, dtype=float), np.zeros(3)
+
+
+def apply_turn_command(reference, start_step, command):
+    if not 0 <= start_step < len(reference):
+        raise ValueError("Dispatch outside reference")
+    anchor = reference[start_step].copy()
+    if not np.allclose(anchor[VEL], [command.speed, 0, 0], atol=1e-10):
+        raise ValueError("Turn must start after the +X acceleration ramp")
+    if not np.isclose(anchor[4], command.waypoint[2]):
+        raise ValueError("Constant-altitude command/waypoint conflict")
+    changed = reference.copy()
+    for step in range(start_step, len(changed)):
+        pos, vel = turn_sample((step-start_step)/HZ, anchor, command)
+        changed[step, POS] = pos
+        changed[step, VEL] = vel
+    return changed
+
+
+def clearance(x, fence_x):
+    """Signed BODY-to-plane distance. Apply d_min separately, exactly once."""
+    return fence_x - np.asarray(x) - BODY_RADIUS_M
+
+
+def in_waypoint(position, velocity, command, config):
+    return (np.linalg.norm(np.asarray(position) - command.waypoint) <= config.position_tolerance_m
+            and np.linalg.norm(velocity) <= config.velocity_tolerance_mps)
+
+
+def safety_only_reference(reference, step, state):
+    """Cancel the turn and request hover at current position; never retry mission.
+
+    Uses the existing position PID. A step to zero reference velocity asks it to
+    brake; actual stopping clearance is measured, not assumed safe.
+    """
+    changed = reference.copy()
+    changed[step:, POS] = state[POS]
+    changed[step:, VEL] = 0
+    return changed
