+"""Audit saved calibration and paired flight artifacts; no additional flights."""
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+import numpy as np
+from .mission import BODY_RADIUS_M, Config, HZ, POS
+from .policies import staleguard_status, fixed_ttl_expired, first_step_after_check
+from .reporting import summarize
+
+
+def validate(logs):
+    logs = Path(logs)
+    dev = logs/'development_measured_bound'
+    config = Config()
+    attempts = [json.loads(x) for x in (dev/'attempts.jsonl').read_text().splitlines()]
+    scenarios = {}
+    candidate_count = 0
+    for attempt in attempts:
+        seed = attempt['seed']
+        directory = dev/f'seed_{seed}'
+        candidates = [json.loads(x) for x in (directory/'candidates.jsonl').read_text().splitlines()]
+        candidate_count += len(candidates)
+        assert len(candidates) == attempt['candidate_count']
+        nominal = json.loads((directory/'nominal_bound.json').read_text())
+        assert candidates[0]['approval_s'] >= nominal['first_violation_s']
+        for row in candidates:
+            assert row['command'] == attempt['generated']['command']
+            result = row['outcome']
+            assert result['safe_completion'] == (result['safe'] and result['completed'])
+        assert all(row['rejected_because'] for row in candidates[:-1])
+        if attempt['accepted']:
+            assert not candidates[-1]['rejected_because']
+            assert candidates[-1]['approval_s'] == attempt['selected']['approval_s']
+            digest = hashlib.sha256((directory/'approval.pkl').read_bytes()).hexdigest()
+            assert digest == attempt['snapshot_sha256']
+            replay = json.loads((directory/'d0_replay.json').read_text())
+            assert replay['safe_completion'] and replay['min_clearance_m'] >= config.d_min_m
+            scenarios[seed] = attempt['selected']
+        else:
+            assert candidates[-1]['rejected_because']
+    rows = [json.loads(x) for x in (logs/'policy_smoke/executions.jsonl').read_text().splitlines()]
+    for result in rows:
+        seed, delay = result['seed'], result['delay_s']
+        s = scenarios[seed]
+        event = result['event']
+        policy = event['policy']
+        assert result['safe_completion'] == (result['safe'] and result['completed'])
+        assert result['safe'] == (result['min_clearance_m'] >= config.d_min_m)
+        assert result['physics_samples'] == result['expected_physics_samples']
+        if result['pre_dispatch_violation_s'] is not None:
+            assert not result['safe_completion'] and not result['safe']
+        path = logs/f'policy_smoke/seed{seed}_D{delay}_{policy}.npz'
+        trace = np.load(path)['controls']
+        minimum = np.min(s['fence_x']-trace[:,1]-BODY_RADIUS_M)
+        assert result['min_clearance_m'] <= minimum + 1e-6
+        original = np.load(dev/f'seed_{seed}/d0_trace.npz')['controls']
+        approval = round(s['approval_s']*HZ)
+        np.testing.assert_array_equal(trace[:approval+1,1:13], original[:approval+1,1:13])
+        if event['application_step'] is not None:
+            np.testing.assert_allclose(trace[-1, [13+i for i in POS]], s['command']['waypoint'])
+        if policy == 'staleguard':
+            prediction = json.loads((logs/f'policy_smoke/prediction_seed_{seed}.json').read_text())
+            ready, recover = staleguard_status(prediction, round(delay*HZ))
+            assert event['prediction_ready'] == ready
+            assert (event['fallback_step'] is not None) == recover
+            if not ready:
+                assert event['application_step'] == event['scheduled_dispatch_step']
+        elif policy == 'use_time_recheck':
+            decision = first_step_after_check(event['scheduled_dispatch_step'], event['computation_s'])
+            assert event['decision_step'] == decision
+            assert (event['fallback_step'] is not None) == (not event['check']['safe'])
+            assert (event['fallback_step'] if event['fallback_step'] is not None else event['application_step']) == decision
+            np.testing.assert_array_equal(event['check_state'], trace[event['scheduled_dispatch_step'],1:13])
+        elif policy == 'fixed_ttl':
+            assert (event['fallback_step'] is not None) == fixed_ttl_expired(round(delay*HZ))
+    summary = summarize(logs/'policy_smoke')
+    assert not summary['partial_blocks']
+    assert len(rows) == 80 and len(scenarios) == 5
+    return dict(accepted=len(scenarios), attempted=len(attempts), candidates=candidate_count,
+                audited_policy_flights=len(rows), paired_blocks=summary['paired_blocks'], status='PASS')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(__doc__)
+    parser.add_argument('--logs', default=str(Path(__file__).resolve().parent/'logs'))
+    print(json.dumps(validate(parser.parse_args().logs), indent=2))
